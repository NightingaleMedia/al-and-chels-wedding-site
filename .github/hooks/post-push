#!/bin/bash
# post-push hook
# Automatically generates and updates PR description using GitHub Copilot CLI with MCP

# Color output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${BLUE}🤖 Checking for PR to update...${NC}"

# Get current branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Get the remote and repo info
REMOTE_URL=$(git config --get remote.origin.url)

# Extract owner/repo from remote URL
if [[ $REMOTE_URL =~ github.com[:/]([^/]+)/([^/.]+) ]]; then
    OWNER="${BASH_REMATCH[1]}"
    REPO="${BASH_REMATCH[2]}"
else
    echo "Could not parse GitHub owner/repo from remote URL"
    exit 0
fi

# Check if there's a PR for this branch
echo "Checking for PR in $OWNER/$REPO for branch $CURRENT_BRANCH..."

PR_NUMBER=$(gh pr list --head "$CURRENT_BRANCH" --json number --jq '.[0].number' 2>/dev/null)

if [ -z "$PR_NUMBER" ]; then
    echo -e "${YELLOW}No PR found for branch '$CURRENT_BRANCH'${NC}"
    echo "Create a PR first with: gh pr create"
    exit 0
fi

echo -e "${GREEN}✓ Found PR #$PR_NUMBER${NC}"

# Get the base branch
BASE_BRANCH=$(gh pr view "$PR_NUMBER" --json baseRefName --jq '.baseRefName' 2>/dev/null)

if [ -z "$BASE_BRANCH" ]; then
    echo "Could not determine base branch"
    exit 0
fi

echo "Getting diff from $BASE_BRANCH...$CURRENT_BRANCH..."

# Get the diff
DIFF=$(git diff "$BASE_BRANCH"..."$CURRENT_BRANCH")

if [ -z "$DIFF" ]; then
    echo "No changes detected"
    exit 0
fi

# Get list of changed files
FILES_CHANGED=$(git diff --name-status "$BASE_BRANCH"..."$CURRENT_BRANCH")

echo -e "${BLUE}📝 Generating PR summary with GitHub Copilot...${NC}"

# Create a comprehensive prompt for Copilot
read -r -d '' PROMPT << EOM
Analyze this PR and create a clear, structured summary for the PR description.

Repository: $OWNER/$REPO
PR #$PR_NUMBER
Branch: $CURRENT_BRANCH → $BASE_BRANCH

Files changed:
$FILES_CHANGED

Focus on WHAT changed, not code review. Provide:
1. **Overview** (2-3 sentences)
2. **Key Changes** (bulleted list by area/component)
3. **Impact** (what this enables or fixes)

Use markdown formatting. Be concise and clear.

Diff (first 10000 chars):
\`\`\`
${DIFF:0:10000}
\`\`\`

Respond with ONLY the markdown summary, no preamble.
EOM

# Use gh copilot with MCP to generate the summary
SUMMARY=$(gh copilot -p "$PROMPT" 2>/dev/null)

if [ -z "$SUMMARY" ]; then
    echo "Failed to generate summary"
    exit 0
fi

# Get current PR body
CURRENT_BODY=$(gh pr view "$PR_NUMBER" --json body --jq '.body' 2>/dev/null)

# Check if we already have an auto-generated summary section
if echo "$CURRENT_BODY" | grep -q "<!-- AUTO-GENERATED-SUMMARY -->"; then
    # Replace existing summary
    echo -e "${BLUE}Updating existing auto-generated summary...${NC}"
    NEW_BODY=$(echo "$CURRENT_BODY" | sed '/<!-- AUTO-GENERATED-SUMMARY -->/,/<!-- \/AUTO-GENERATED-SUMMARY -->/c\
<!-- AUTO-GENERATED-SUMMARY -->\
## 🤖 Auto-Generated Summary\
\
'"$SUMMARY"'\
\
---\
*Last updated: '"$(date -u +"%Y-%m-%d %H:%M:%S UTC")"'*\
<!-- /AUTO-GENERATED-SUMMARY -->')
else
    # Append new summary
    echo -e "${BLUE}Adding auto-generated summary to PR...${NC}"
    NEW_BODY="$CURRENT_BODY

<!-- AUTO-GENERATED-SUMMARY -->
## 🤖 Auto-Generated Summary

$SUMMARY

---
*Generated: $(date -u +"%Y-%m-%d %H:%M:%S UTC")*
<!-- /AUTO-GENERATED-SUMMARY -->"
fi

# Update PR description
echo "$NEW_BODY" | gh pr edit "$PR_NUMBER" --body-file -

if [ $? -eq 0 ]; then
    echo -e "${GREEN}✓ PR #$PR_NUMBER updated successfully!${NC}"
    echo -e "${BLUE}View at: $(gh pr view "$PR_NUMBER" --json url --jq '.url')${NC}"
else
    echo "Failed to update PR"
    exit 1
fi
