# Local dev reads .env.local. Deploys read .env.development (wedding-site-dev)
# and .env.production (wedding-site) — see scripts/deploy.sh.

# Base URL for the external wedding guest-data API. Server-side only — read exclusively
# in src/serverActions/rsvp/ and never exposed to the client bundle.
# See specs/001-rsvp-server-actions/spec.md for the API contract this site talks to.
# Field shapes and endpoints are defined in specs/002-rsvp-types/spec.md.
WEDDING_BACKEND=

# Cloudinary configuration for photo gallery uploads and storage
# Public cloud name (exposed to browser for direct uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# API credentials (server-side only)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload preset name configured in Cloudinary dashboard
CLOUDINARY_UPLOAD_PRESET=wedding_photos
# 6-digit PIN for admin moderation interface
ADMIN_PIN=
